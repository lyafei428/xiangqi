{
  "name": "xiangqi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "中国象棋在线游戏：对弈 · 教学 · 规则练习",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node src/server/main.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:ui": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run test:ui"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
